# Copia a .env.local (o corre `npm run setup`, que lo genera con secretos nuevos).
# SIN VALORES: aqui no se escriben secretos. Todo funciona en local sin credenciales externas (SPEC 12.2).

NODE_ENV=
# En Vercel puede quedar vacia: se usa la direccion del despliegue. Con dominio propio, definirla.
APP_URL=

# --- Auth (Better Auth): usuario y contrasena, sin correo ------------------------------
# Secreto largo (>= 32 caracteres). `npm run setup` lo genera en local.
BETTER_AUTH_SECRET=

# --- Base de datos ---------------------------------------------------------------------
# Vacia => PGlite local en PGLITE_DIR (un solo proceso: solo el servidor abre la base).
# Produccion: URL "pooled" de Neon con el rol `app` (NO duenio, D-31).
DATABASE_URL=
# Solo CI y migraciones: URL directa (no agrupada) con el rol `migrador` (duenio).
DATABASE_URL_UNPOOLED=
PGLITE_DIR=

# --- Archivos (fotos) ------------------------------------------------------------------
# local => .data/uploads/ ; blob => Vercel Blob privado.
ALMACEN=
BLOB_READ_WRITE_TOKEN=
UPLOADS_DIR=

# --- Contacto -----------------------------------------------------------------------------
# Lo que ven las personas en la pantalla de entrada («pidesela a ...»).
CONTACTO_ADMIN=

# --- Reglas ajustables (valores por defecto entre parentesis) ----------------------------
RECORDATORIO_MANUAL_MAX_DIA=
SESION_INACTIVIDAD_HORAS_INTERNO=
SESION_INACTIVIDAD_HORAS_EXTERNO=
SESION_ABSOLUTA_HORAS_INTERNO=
SESION_ABSOLUTA_HORAS_EXTERNO=
# advertir (por defecto) | bloquear
CIERRE_MODO=
ACCESO_AGENCIA_DIAS_TRAS_CLASIFICAR=

# --- Solo desarrollo ---------------------------------------------------------------------
# El servidor migra y siembra la base local al arrancar (por defecto: true).
AUTO_PREPARAR_BD_DEV=
